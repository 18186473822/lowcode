{
  "name": "@lc/server",
  "version": "0.1.0",
  "private": true,
  "description": "低代码平台服务端骨架（NestJS）：登录 + 页面 Schema 存取 + 版本发布/回滚 + 动态 CRUD + 文件上传",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:observability": "node scripts/smoke-observability.mjs"
  },
  "dependencies": {
    "@lc/expression": "workspace:*",
    "@lc/renderer": "workspace:*",
    "@lc/schema": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0"
  }
}
