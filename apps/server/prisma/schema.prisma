// MySQL 8.0 + Prisma 6 数据模型（Phase 4 数据库第一批 + 第二批）
//
// 设计原则：
// - 已落「业务主数据」：用户/角色、页面/版本、模型定义、业务记录、页面授权；
//   第二批补流程定义/实例、运维事件、应用配置（flows / flow-instances / ops / apps.json）。
// - 仓储接口不变：`LC_STORAGE=mysql` 时由 MySQL 实现替换 JSON 实现，服务层零改动。
// - 时间统一 `DATETIME(3)`，与现有 ISO 字符串（毫秒）对齐；JSON 列保存协议原始结构，
//   避免把动态 Schema/记录 payload 拆成大量稀疏列。
// - 页面版本用 `(page_id, version)` 复合主键；记录用 `(model_id, id)` 复合主键，
//   与现有「按模型分目录」的存储语义一致。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @db.VarChar(64)
  username     String     @unique @db.VarChar(64)
  displayName  String     @db.VarChar(128)
  passwordHash String     @db.VarChar(255)
  status       String     @default("active") @db.VarChar(16)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)
  roles        UserRole[]

  @@map("users")
}

model Role {
  key       String     @id @db.VarChar(64)
  name      String     @db.VarChar(128)
  perms     Json
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId  String @db.VarChar(64)
  roleKey String @db.VarChar(64)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  @@id([userId, roleKey])
  @@index([roleKey])
  @@map("user_roles")
}

model Page {
  id             String        @id @db.VarChar(64)
  appId          String        @db.VarChar(64)
  name           String        @db.VarChar(128)
  type           String        @db.VarChar(32)
  status         String        @db.VarChar(16)
  currentVersion Int           @default(0)
  // 页面行版本：保存草稿/发布/回滚 +1；ETag/If-Match 乐观锁
  revision       Int           @default(0)
  draft          Json?
  draftUpdatedAt DateTime?     @db.DateTime(3)
  draftUpdatedBy String?       @db.VarChar(64)
  createdAt      DateTime      @db.DateTime(3)
  updatedAt      DateTime      @db.DateTime(3)
  versions       PageVersion[]

  @@index([appId])
  @@map("pages")
}

model PageVersion {
  pageId     String   @db.VarChar(64)
  version    Int
  schemaJson Json
  createdBy  String   @db.VarChar(64)
  createdAt  DateTime @db.DateTime(3)
  note       String?  @db.VarChar(500)
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, version])
  @@map("page_versions")
}

model ModelDef {
  id         String       @id @db.VarChar(64)
  schemaJson Json
  createdAt  DateTime     @db.DateTime(3)
  updatedAt  DateTime     @db.DateTime(3)
  createdBy  String       @db.VarChar(64)
  updatedBy  String       @db.VarChar(64)
  records    DataRecord[]

  @@map("models")
}

model DataRecord {
  modelId   String    @db.VarChar(64)
  id        String    @db.VarChar(64)
  payload   Json
  // 记录行版本：每次更新/软删 +1；ETag/If-Match 乐观锁
  revision  Int       @default(0)
  createdBy String    @db.VarChar(64)
  createdAt DateTime  @db.DateTime(3)
  updatedBy String?   @db.VarChar(64)
  updatedAt DateTime  @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  model     ModelDef  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([modelId, id])
  @@index([modelId, deletedAt])
  @@map("data_records")
}

model RbacPageGrant {
  pageId String @id @db.VarChar(64)
  roles  Json

  @@map("rbac_page_grants")
}

// 流程定义与实例分表：删除定义不级联删除实例（审计必须保留）。
model FlowDefinition {
  flowId     String   @id @db.VarChar(64)
  modelId    String   @db.VarChar(64)
  name       String   @db.VarChar(128)
  schemaJson Json
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([modelId])
  @@map("flow_definitions")
}

model FlowInstance {
  id            String   @id @db.VarChar(64)
  flowId        String   @db.VarChar(64)
  modelId       String   @db.VarChar(64)
  recordId      String   @db.VarChar(64)
  status        String   @db.VarChar(16)
  currentNodeId String?  @db.VarChar(64)
  createdBy     String   @db.VarChar(64)
  createdAt     DateTime @db.DateTime(3)
  updatedAt     DateTime @db.DateTime(3)
  // 实例行版本：审批推进 +1；多实例并发审批 CAS
  revision      Int      @default(0)
  // 记录回写 outbox：实例先落盘，记录回写失败/进程退出时由读取路径补偿
  pendingPatchJson Json?
  tasksJson     Json
  historyJson   Json

  @@index([modelId, recordId])
  @@index([flowId])
  @@index([status])
  @@map("flow_instances")
}

// 运维事件保留自增 seq：同一批事件 at 相同，靠 seq 维持「后写在前」的可解释顺序。
model OpsEvent {
  seq         Int      @id @default(autoincrement())
  id          String   @unique @db.VarChar(80)
  type        String   @db.VarChar(16)
  name        String   @db.VarChar(64)
  pageId      String?  @db.VarChar(64)
  pageVersion String?  @db.VarChar(16)
  source      String   @db.VarChar(16)
  userId      String?  @db.VarChar(64)
  message     String?  @db.Text
  durationMs  Float?   @db.Double
  detailJson  Json?
  at          DateTime @db.DateTime(3)

  @@index([type])
  @@index([pageId])
  @@index([at])
  @@map("ops_events")
}

// 应用配置当前只有 theme；单行 id=default，保留扩展成多应用的余地。
model AppConfig {
  id        String   @id @db.VarChar(32)
  theme     Json?
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@map("app_config")
}

// 文件元数据与内容同表（Phase 4 文件落库）：
// - id 为 uuid + 白名单扩展名，服务层仍做路径穿越白名单校验；
// - content 用 LONGBLOB，单文件上限 10MB，避免元数据与字节分表后的半写状态；
// - 文件名用 TEXT，不因客户端超长原名导致写库失败（磁盘模式原本也不截断）。
model FileObject {
  id           String   @id @db.VarChar(160)
  originalName String   @db.Text
  mimeType     String   @db.VarChar(255)
  size         Int
  uploadedAt   DateTime @db.DateTime(3)
  uploadedBy   String   @db.VarChar(128)
  content      Bytes    @db.LongBlob

  @@index([uploadedAt])
  @@map("files")
}
