{
  "name": "lowcode",
  "private": true,
  "version": "0.1.0",
  "description": "移动端低代码平台（uni-app + Vue3 全端）—— Monorepo 根",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "coverage": "vitest run --coverage --workspace config/vitest.projects.ts --no-file-parallelism",
    "tokens:check": "node scripts/check-tokens.mjs",
    "tokens:rpx": "node scripts/build-tokens-rpx.mjs",
    "color:check": "node scripts/check-color-literals.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "dimensions:check": "node scripts/tokenize-dimensions.mjs --check",
    "rpx:check": "node scripts/tokenize-rpx.mjs --check",
    "tokens:audit": "node scripts/audit-token-usage.mjs",
    "icons:sheet": "node scripts/build-icon-sheet.mjs",
    "design:check": "pnpm tokens:check && pnpm color:check && pnpm dimensions:check && pnpm rpx:check && node scripts/build-tokens-rpx.mjs --check && pnpm contrast:check",
    "smoke:security": "node apps/server/scripts/smoke-security.mjs",
    "smoke:observability": "pnpm -F @lc/server smoke:observability",
    "postinstall": "pnpm -F @lc/server prisma:generate",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0"
}
